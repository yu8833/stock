# ===== instock docker-compose 环境变量示例 =====
# 使用方式：复制为 docker/.env 并按需修改
#   cp docker/.env.example docker/.env
#   vim docker/.env
# 然后通过 docker compose --env-file docker/.env 启动。

# ---------- MariaDB ----------
# root 密码（至少 6 位，建议修改为强密码）
MARIADB_ROOT_PASSWORD=instock_root_pass
# 业务数据库账号（instock 应用用这个账号连接）
MARIADB_USER=instock
MARIADB_PASSWORD=instock_pass
# 宿主机端口（供外部工具连接数据库调试；生产环境建议仅暴露 127.0.0.1）
MARIADB_PORT=3307

# ---------- 应用 ----------
# Web 端口（浏览器访问 http://localhost:9988）
INSTOCK_PORT=9988
# supervisord 控制台端口（浏览器访问 http://localhost:9001）
SUPERVISOR_PORT=9001
# tushare 会员 token（可选；留空则仅使用东财/新浪数据源）
TUSHARE_TOKEN=

# ---------- 持久化根目录 ----------
# 容器数据挂载根目录；默认在 docker/data/ 下
INSTOCK_VOLUME_ROOT=./data
